#!/usr/bin/env bash

version=1.0.16
revision=3

tarball_url="https://www.x.org/releases/individual/lib/libXaw-${version}.tar.xz"
tarball_sha256="731d572b54c708f81e197a6afa8016918e2e06dfd3025e066ca642a5b8c39c8f"

cross_compile=yes

# Build both Xaw6 and Xaw7.  Xaw7 additionally needs libxpm (packaged), which
# supplies the pixmap-backed widgets; xclock is an Xaw7 client and requires the
# xaw7.pc pkg-config file that only gets installed when Xaw7 is built.
deps="mlibc libx11 libxt libxext libxmu libxpm xorgproto"
hostdeps="roxy-llvm"
imagedeps="gcc libc6-dev make pkg-config"

source "${base_dir}/build-systems/autotools.sh"

prepare() {
	autotools_patch_roxy_target
}

configure() {
	autotools_configure
}

build() {
	autotools_build
}

package() {
	autotools_install
}
