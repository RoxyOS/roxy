#!/usr/bin/env bash

version=411
revision=4

# xterm is maintained outside x.org by Thomas Dickey and released as xterm-<NNN>.tgz.
tarball_url="https://invisible-mirror.net/archives/xterm/xterm-${version}.tgz"
tarball_sha256="969be283670deadd66934865c4de6c5ab045e3a3facc2b228decf91a20d8c36c"

cross_compile=yes

# X11/Xt/Xext/Xmu plus Xaw (Athena) are required for the toolkit widgets.
# ncurses provides the termcap/terminfo entry for xterm.
deps="mlibc libx11 libxt libxext libxmu libxaw ncurses xorgproto"
hostdeps="roxy-llvm"
imagedeps="gcc libc6-dev make pkg-config"
clean_workdirs=no

source "${base_dir}/build-systems/autotools.sh"

prepare() {
	autotools_patch_roxy_target
}

configure() {
	export CPPFLAGS=-D_GNU_SOURCE

	# Disable optional dependencies that are not packaged: Xcursor, Xpm,
	# Xinerama, Xft/fontconfig, and the setuid/setgid install.
	autotools_configure \
		--disable-xcursor \
		--with-xpm=no \
		--without-xinerama \
		--disable-setuid \
		--disable-setgid

	# Roxy is a Unix98-PTY host: the kernel provides /dev/ptmx (master open) plus
	# TIOCGPTN/TIOCSPTLCK, and mlibc supplies grantpt/ptsname/unlockpt/posix_openpt.
	# xterm's CF_FUNC_GRANTPT feature probes are AC_RUN_IFELSE, which cross-compilation
	# marks "maybe" and skips, so HAVE_GRANTPT_PTY_ISATTY (the gate that sends get_pty()
	# down the posix_openpt()/Unix98 path) is left undefined. Force it here; the macro is
	# correct for this host and is what lets xterm allocate a pty instead of scanning
	# /dev/ptyXX /dev/ttyXX. configure() runs with cwd in the package build dir, which is where
	# the generated config header lands (do_configure cd's there before calling configure).
	sed -i 's|/\* #undef HAVE_GRANTPT_PTY_ISATTY \*/|#define HAVE_GRANTPT_PTY_ISATTY 1|' \
		xtermcfg.h
}

build() {
	autotools_build
}

package() {
	autotools_install
}
