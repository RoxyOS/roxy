+#ifdef __roxy__
+/*
+ * Roxy has no /dev/pts: a pty pair is an anonymous descriptor pair, so the slave that openpty()
+ * returned is inherited across fork() and used directly here instead of being reopened by name.
+ * TIOCSCTTY makes it this session's controlling terminal.
+ */
+static int
+roxy_open_slave(void)
+{
+    int fd = opened_tty;
+
+    if (fd >= 0) {
+	opened_tty = -1;
+	IGNORE_RC(ioctl(fd, TIOCSCTTY, 0));
+    }
+    return fd;
+}
+#endif
