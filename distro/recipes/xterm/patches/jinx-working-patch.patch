diff --git xterm-clean/xterm_io.h xterm-workdir/xterm_io.h
index bf7014b..d337c9d 100644
--- xterm-clean/xterm_io.h
+++ xterm-workdir/xterm_io.h
@@ -35,6 +35,27 @@
 
 #include <xterm.h>
 
+/*
+ * Roxy: define _GNU_SOURCE so mlibc exposes POSIX termios declarations
+ * (ICANON/VMIN/TIOCSWINSZ/NCCS) that this header relies on, then include
+ * termios.h unconditionally and select the POSIX termios API. Roxy defines
+ * no __linux__/BSD platform macro, so xterm_io.h's platform guards would
+ * otherwise skip termios entirely.
+ */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <termios.h>
+#ifndef USE_POSIX_TERMIOS
+#define USE_POSIX_TERMIOS
+#endif
+/* mlibc's setpgrp() is the no-arg POSIX form (unistd.h:396), matching the
+ * USE_SYSV_PGRP path xterm uses on Linux. Select it so the code avoids the
+ * two-argument setpgrp(0, 0) BSD form that mlibc does not provide. */
+#ifndef USE_SYSV_PGRP
+#define USE_SYSV_PGRP
+#endif
+
 /*
