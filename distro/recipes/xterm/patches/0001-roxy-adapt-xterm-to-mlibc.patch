+ * form is not provided.
+ */
+#if defined(__roxy__)
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <termios.h>
+#ifndef USE_POSIX_TERMIOS
+#define USE_POSIX_TERMIOS
+#endif
+#ifndef USE_SYSV_PGRP
+#define USE_SYSV_PGRP
+#endif
+#endif /* __roxy__ */
