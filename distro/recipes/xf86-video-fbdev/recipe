#!/usr/bin/env bash

version=0.5.1
revision=3

tarball_url="https://xorg.freedesktop.org/archive/individual/driver/xf86-video-fbdev-${version}.tar.gz"
tarball_sha256="5e73c01f6ede09ddbc1f553fecdf35dd8efe76b44c7ed263de786a5968c5116f"

cross_compile=yes

deps="mlibc xorg-server xorgproto"
hostdeps="roxy-llvm"
imagedeps="gcc libc6-dev make pkg-config"

source "${base_dir}/build-systems/autotools.sh"

prepare() {
	autotools_patch_roxy_target
}

configure() {
	# SYSROOT lets the driver link the Xorg server's libfbdevhw/libshadow modules
	# (see patches/0002): mlibc's rtld binds eagerly, so the driver's submodule
	# symbols must be DT_NEEDED dependencies instead of late-loaded modules.
	SYSROOT="${sysroot}" autotools_configure
}

build() {
	autotools_build
}

package() {
	autotools_install
}
