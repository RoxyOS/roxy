#!/usr/bin/env bash

version=0.0.0.20260904
revision=1

git_url="https://github.com/RoxyOS/mlibc"
commit="160636d86fbed86959e7eff4e652c2dc070afb89"
shallow=no

source_hostdeps="meson"
source_imagedeps="ca-certificates git python3"
source_allow_network=yes

cross_compile=yes
clean_workdirs=no

hostdeps="meson roxy-llvm"
imagedeps="ninja-build pkg-config python3"

source "${base_dir}/build-systems/meson.sh"

prepare() {
	meson subprojects download \
		freestnd-c-hdrs \
		freestnd-cxx-hdrs \
		frigg \
		libsmarter
}

configure() {
	meson_configure \
		-Dcpp_args=-D_GNU_SOURCE \
		-Ddefault_library=both \
		-Dlibgcc_dependency=true \
		-Duse_freestnd_hdrs=enabled
}

build() {
	meson_build
}

package() {
	meson_install
}
