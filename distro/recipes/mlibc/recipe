#!/usr/bin/env bash

version=0.0.0.20260718
revision=2

git_url="https://github.com/RoxyOS/mlibc"
commit="8713f9dddc0810892e34e5f59729b6c50fcceafb"
shallow=no

source_imagedeps="ca-certificates git meson"
source_allow_network=yes

cross_compile=yes
clean_workdirs=no

imagedeps="clang libclang-rt-dev lld llvm meson ninja-build pkg-config"

source "${base_dir}/build-systems/meson.sh"

prepare() {
	meson subprojects download \
		freestnd-c-hdrs \
		freestnd-cxx-hdrs \
		frigg \
		libsmarter
}

configure() {
	meson_configure \
		-Ddefault_library=both \
		-Dcpp_link_args=-fuse-ld=lld,--rtlib=compiler-rt \
		-Dlibgcc_dependency=true \
		-Duse_freestnd_hdrs=enabled
}

build() {
	meson_build
}

package() {
	meson_install
}
