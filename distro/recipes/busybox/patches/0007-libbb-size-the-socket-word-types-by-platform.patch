diff --git busybox-clean/include/platform.h busybox-workdir/include/platform.h
index 3414b97..6b9f87a 100644
--- busybox-clean/include/platform.h
+++ busybox-workdir/include/platform.h
@@ -295,6 +295,21 @@ typedef int smallint;
 typedef unsigned smalluint;
 #endif
 
+/* ---- Size of the SOCK_ and AF_ storage -------------------- */
+
+/* Platforms number their socket types and address families differently: Linux's fit in a signed
+ * byte, while Roxy starts each word above the whole range the other personality's numbering uses
+ * (mlibc abi-bits/socket.h), which needs an int. The check in libbb.h is written against these,
+ * so a platform whose words no longer fit fails the build instead of truncating them silently.
+ */
+#if defined(__roxy__)
+# define BB_SOCKWORD_TYPE int
+# define BB_SOCKWORD_MAX  INT_MAX
+#else
+# define BB_SOCKWORD_TYPE int8_t
+# define BB_SOCKWORD_MAX  127
+#endif
+
 /* ISO C Standard:  7.16  Boolean type and values  <stdbool.h> */
 #if (defined __digital__ && defined __unix__)
 /* old system without (proper) C99 support */
