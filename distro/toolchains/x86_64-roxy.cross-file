[binaries]
c = ['clang', '--target=x86_64-unknown-roxy', '--sysroot=/sysroot']
cpp = ['clang++', '--target=x86_64-unknown-roxy', '--sysroot=/sysroot']
ar = 'llvm-ar'
strip = 'llvm-strip'
# Meson needs a pkg-config designated for the host machine to look up target dependencies; the
# host binary is the container's pkg-config, pointed at the sysroot by `pkg_config_libdir` below.
pkgconfig = 'pkg-config'

[properties]
needs_exe_wrapper = true

sys_root = '/sysroot'
pkg_config_libdir = ['/sysroot/usr/lib/pkgconfig', '/sysroot/usr/share/pkgconfig']

[host_machine]
system = 'roxy'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
