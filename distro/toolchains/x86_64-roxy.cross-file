[binaries]
c = ['clang', '--target=x86_64-unknown-roxy', '--sysroot=/sysroot']
cpp = ['clang++', '--target=x86_64-unknown-roxy', '--sysroot=/sysroot']
ar = 'llvm-ar'
strip = 'llvm-strip'

[properties]
needs_exe_wrapper = true

sys_root = '/sysroot'
pkg_config_libdir = ['/sysroot/usr/lib/pkgconfig', '/sysroot/usr/share/pkgconfig']

[host_machine]
system = 'roxy'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
